# oelala-storage configuration
node:
  id: "oelala-main"
  name: "Oelala Primary Storage"
  type: primary

storage:
  path: "/home/flip/oelala/media"
  max_size_gb: 500
  cache_size_mb: 2048

api:
  http_port: 7990
  grpc_port: 7991
  enable_tls: false

sync:
  enabled: true
  peers: []
  strategy: realtime
  interval_minutes: 15

logging:
  level: info
  format: console

metrics:
  enabled: true
  port: 7992

tls:
  enabled: false
  auto_cert: true

security:
  encryption_at_rest: false
  # Admin secret for /admin UI - CHANGE THIS!
  admin_secret: "CHANGE_ME_TO_SOMETHING_SECRET"
  # Secret for signed URL verification (HMAC-SHA256)
  # Generate with: openssl rand -hex 32
  signing_secret: "CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32"
  # Static auth tokens (optional - prefer creating via /admin UI)
  auth_tokens:
    - name: "oelala-backend"
      token: "YOUR_API_KEY_HERE"
      permissions: ["read", "write", "delete"]
    - name: "readonly"
      token: ""
      permissions: ["read"]

# Webhook notifications for storage events
webhooks:
  enabled: false
  targets:
    - url: "https://api.oelala.xyz/webhooks/storage"
      secret: "CHANGE_ME_HMAC_SECRET"
      events: ["file.uploaded", "file.deleted"]  # Empty = all events
    # - url: "https://example.com/webhook"
    #   secret: "another-secret"
    #   events: []  # All events
  retry:
    max_attempts: 3
    backoff_secs: 5
